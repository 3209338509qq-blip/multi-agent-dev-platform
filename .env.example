# ============================================================
# Multi-Agent Dev Platform - 环境变量示例
# 复制为 .env 后填写真实值：cp .env.example .env
# 切勿将 .env 提交到 Git（已在 .gitignore 中排除）
# ============================================================

# ---------- LLM Provider（统一抽象，可切换） ----------
# openai_compatible | anthropic | fake（仅单元测试使用）
LLM_PROVIDER=openai_compatible
# OpenAI 兼容端点：DeepSeek / MiMo / Qwen / OpenAI 等均可
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 仅 anthropic 供应商需要
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# ---------- 数据库 ----------
# 本地开发默认 SQLite；compose 部署自动切换 PostgreSQL（psycopg 驱动已内置）
DATABASE_URL=sqlite+aiosqlite:///./backend/data/platform.db

# ---------- Redis（可选） ----------
# 留空时使用进程内 asyncio 事件总线（本地开发/Demo 完全可用）
REDIS_URL=

# ---------- 工作区与运行参数 ----------
WORKSPACE_ROOT=./workspace
SANDBOX_BACKEND=local
AGENT_TIMEOUT_SECONDS=1800
TASK_MAX_RETRIES=2
DEBUG_MAX_ROUNDS=3
PROJECT_TOKEN_BUDGET=600000
MAX_PARALLEL_TASKS=2

# ---------- Web ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
